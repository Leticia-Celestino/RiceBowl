#!/bin/sh

set -eu

: "${API_UPSTREAM:?API_UPSTREAM must be set}"

upstream_address="${API_UPSTREAM#http://}"
upstream_address="${upstream_address#https://}"

case "$upstream_address" in
    *:*)
        API_UPSTREAM_HOST="${upstream_address%:*}"
        API_UPSTREAM_PORT="${upstream_address##*:}"
        ;;
    *)
        API_UPSTREAM_HOST="$upstream_address"
        API_UPSTREAM_PORT=80
        ;;
esac

DNS_RESOLVER="$(awk '/^nameserver[[:space:]]/ { print $2; exit }' /etc/resolv.conf)"
: "${DNS_RESOLVER:=127.0.0.11}"

export API_UPSTREAM_HOST API_UPSTREAM_PORT DNS_RESOLVER
